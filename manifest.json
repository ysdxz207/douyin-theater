{
  "manifest_version": 3,
  "name": "抖音追剧助手",
  "version": "1.0.0",
  "description": "在工具栏弹窗中一键调整抖音追剧模式。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.douyin.com/*"],
  "action": {
    "default_title": "抖音追剧助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/*"],
      "css": ["theater.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
